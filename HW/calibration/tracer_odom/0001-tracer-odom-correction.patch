From c10aa902f74186ed41923f13b43ba422335bc6ab Mon Sep 17 00:00:00 2001
From: Patrick-SCH03 <wwoo5241@gmail.com>
Date: Sat, 10 Oct 2026 23:34:47 +0900
Subject: [PATCH] Add odometry velocity scale/bias parameters (measured
 defaults in launch)

---
 .../include/tracer_base/tracer_base_ros.hpp   |  5 +++++
 .../include/tracer_base/tracer_messenger.hpp  | 21 +++++++++++++++++--
 tracer_base/launch/tracer_base.launch.py      | 15 +++++++++++++
 tracer_base/src/tracer_base_ros.cpp           | 11 ++++++++++
 4 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/tracer_base/include/tracer_base/tracer_base_ros.hpp b/tracer_base/include/tracer_base/tracer_base_ros.hpp
index f9ed6a5..1a1f03e 100644
--- a/tracer_base/include/tracer_base/tracer_base_ros.hpp
+++ b/tracer_base/include/tracer_base/tracer_base_ros.hpp
@@ -38,6 +38,11 @@ class TracerBaseRos : public rclcpp::Node {
   bool simulated_robot_ = false;
   int sim_control_rate_ = 50;
 
+  // odometry correction applied to the firmware-reported motion state
+  double linear_velocity_scale_ = 1.0;
+  double angular_velocity_scale_ = 1.0;
+  double angular_velocity_bias_ = 0.0;
+
 
   std::shared_ptr<TracerRobot> robot_;
   // std::shared_ptr<TracerMiniOmniRobot> omni_robot_;
diff --git a/tracer_base/include/tracer_base/tracer_messenger.hpp b/tracer_base/include/tracer_base/tracer_messenger.hpp
index 94937cd..fc0720f 100644
--- a/tracer_base/include/tracer_base/tracer_messenger.hpp
+++ b/tracer_base/include/tracer_base/tracer_messenger.hpp
@@ -16,6 +16,7 @@
 
 #include <rclcpp/rclcpp.hpp>
 #include <nav_msgs/msg/odometry.hpp>
+#include <cmath>
 #include <geometry_msgs/msg/twist.hpp>
 #include <tf2_ros/transform_broadcaster.h>
 #include <tf2_geometry_msgs/tf2_geometry_msgs.hpp>
@@ -37,6 +38,12 @@ class TracerMessenger {
   void SetOdometryFrame(std::string frame) { odom_frame_ = frame; }
   void SetBaseFrame(std::string frame) { base_frame_ = frame; }
   void SetOdometryTopicName(std::string name) { odom_topic_name_ = name; }
+  void SetOdometryCorrection(double linear_scale, double angular_scale,
+                             double angular_bias) {
+    linear_velocity_scale_ = linear_scale;
+    angular_velocity_scale_ = angular_scale;
+    angular_velocity_bias_ = angular_bias;
+  }
 
   void SetSimulationMode(int loop_rate) {
     simulated_robot_ = true;
@@ -172,6 +179,11 @@ class TracerMessenger {
 
   std::shared_ptr<tf2_ros::TransformBroadcaster> tf_broadcaster_;
 
+  // odometry correction (v = s_v * v_rep, w = s_w * w_rep + bias while moving)
+  double linear_velocity_scale_ = 1.0;
+  double angular_velocity_scale_ = 1.0;
+  double angular_velocity_bias_ = 0.0;
+
   // speed variables
   double position_x_ = 0.0;
   double position_y_ = 0.0;
@@ -264,8 +276,13 @@ class TracerMessenger {
 
   void PublishOdometryToROS(const MotionStateMessage &msg, double dt) {
     // perform numerical integration to get an estimation of pose
-    double linear_speed = msg.linear_velocity;
-    double angular_speed = msg.angular_velocity;
+    double linear_speed = linear_velocity_scale_ * msg.linear_velocity;
+    double angular_speed = angular_velocity_scale_ * msg.angular_velocity;
+    // The firmware reports a small yaw-rate offset while the wheels turn.
+    if (std::fabs(msg.linear_velocity) > 1e-3 ||
+        std::fabs(msg.angular_velocity) > 1e-3) {
+      angular_speed += angular_velocity_bias_;
+    }
 
     // if (std::is_base_of<TracerMiniOmniRobot, TracerType>::value) {
     //   lateral_speed = msg.lateral_velocity;
diff --git a/tracer_base/launch/tracer_base.launch.py b/tracer_base/launch/tracer_base.launch.py
index 6601d47..355f3a2 100644
--- a/tracer_base/launch/tracer_base.launch.py
+++ b/tracer_base/launch/tracer_base.launch.py
@@ -27,6 +27,15 @@ def generate_launch_description():
                                                    description='Whether running with simulator')
     sim_control_rate_arg = DeclareLaunchArgument('control_rate', default_value='50',
                                                  description='Simulation control loop update rate')
+    # Odometry correction measured on this robot (2026-10-10, G2 scan matching of
+    # stop-and-go spin/straight bags g2_scan_only_20261010_230526).
+    # Set 1.0 / 1.0 / 0.0 to get the uncorrected firmware odometry.
+    linear_scale_arg = DeclareLaunchArgument('linear_velocity_scale', default_value='1.112',
+                                             description='Scale on reported linear velocity')
+    angular_scale_arg = DeclareLaunchArgument('angular_velocity_scale', default_value='1.319',
+                                              description='Scale on reported angular velocity')
+    angular_bias_arg = DeclareLaunchArgument('angular_velocity_bias', default_value='0.00378',
+                                             description='Yaw-rate offset added while moving [rad/s]')
     
     tracer_base_node = launch_ros.actions.Node(
         package='tracer_base',
@@ -42,6 +51,9 @@ def generate_launch_description():
                 'is_tracer_mini': launch.substitutions.LaunchConfiguration('is_tracer_mini'),
                 'simulated_robot': launch.substitutions.LaunchConfiguration('simulated_robot'),
                 'control_rate': launch.substitutions.LaunchConfiguration('control_rate'),
+                'linear_velocity_scale': launch.substitutions.LaunchConfiguration('linear_velocity_scale'),
+                'angular_velocity_scale': launch.substitutions.LaunchConfiguration('angular_velocity_scale'),
+                'angular_velocity_bias': launch.substitutions.LaunchConfiguration('angular_velocity_bias'),
         }])
 
     return LaunchDescription([
@@ -53,5 +65,8 @@ def generate_launch_description():
         is_tracer_mini_arg,
         simulated_robot_arg,
         sim_control_rate_arg,
+        linear_scale_arg,
+        angular_scale_arg,
+        angular_bias_arg,
         tracer_base_node
     ])
diff --git a/tracer_base/src/tracer_base_ros.cpp b/tracer_base/src/tracer_base_ros.cpp
index 12ff0bd..69a51a3 100644
--- a/tracer_base/src/tracer_base_ros.cpp
+++ b/tracer_base/src/tracer_base_ros.cpp
@@ -26,6 +26,9 @@ TracerBaseRos::TracerBaseRos(std::string node_name)
   this->declare_parameter("is_tracer_mini", rclcpp::ParameterValue(false));
   this->declare_parameter("simulated_robot", rclcpp::ParameterValue(false));
   this->declare_parameter("control_rate", rclcpp::ParameterValue(50));
+  this->declare_parameter("linear_velocity_scale", rclcpp::ParameterValue(1.0));
+  this->declare_parameter("angular_velocity_scale", rclcpp::ParameterValue(1.0));
+  this->declare_parameter("angular_velocity_bias", rclcpp::ParameterValue(0.0));
  /***update for humble***/
   LoadParameters();
 }
@@ -40,6 +43,9 @@ void TracerBaseRos::LoadParameters() {
   this->get_parameter_or<bool>("is_tracer_mini", is_tracer_mini_, false);
   this->get_parameter_or<bool>("simulated_robot", simulated_robot_, false);
   this->get_parameter_or<int>("control_rate", sim_control_rate_, 50);
+  this->get_parameter_or<double>("linear_velocity_scale", linear_velocity_scale_, 1.0);
+  this->get_parameter_or<double>("angular_velocity_scale", angular_velocity_scale_, 1.0);
+  this->get_parameter_or<double>("angular_velocity_bias", angular_velocity_bias_, 0.0);
 
   std::cout << "Loading parameters: " << std::endl;
   std::cout << "- port name: " << port_name_ << std::endl;
@@ -54,6 +60,9 @@ void TracerBaseRos::LoadParameters() {
   std::cout << "- simulated robot: " << std::boolalpha << simulated_robot_
             << std::endl;
   std::cout << "- sim control rate: " << sim_control_rate_ << std::endl;
+  std::cout << "- odom linear velocity scale: " << linear_velocity_scale_ << std::endl;
+  std::cout << "- odom angular velocity scale: " << angular_velocity_scale_ << std::endl;
+  std::cout << "- odom angular velocity bias (moving): " << angular_velocity_bias_ << std::endl;
   std::cout << "----------------------------" << std::endl;
 }
 
@@ -96,6 +105,8 @@ void TracerBaseRos::Run() {
   messenger->SetOdometryFrame(odom_frame_);
   messenger->SetBaseFrame(base_frame_);
   messenger->SetOdometryTopicName(odom_topic_name_);
+  messenger->SetOdometryCorrection(linear_velocity_scale_, angular_velocity_scale_,
+                                   angular_velocity_bias_);
   if (simulated_robot_) messenger->SetSimulationMode(sim_control_rate_);
 
   // connect to robot and setup ROS subscription
-- 
2.34.1

