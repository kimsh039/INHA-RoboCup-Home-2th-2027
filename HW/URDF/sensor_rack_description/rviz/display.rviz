Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.1
      Frames:
        All Enabled: false
        base_link:
          Value: true
        laser_frame:
          Value: true
        livox_frame:
          Value: true
        camera_optical_frame:
          Value: true
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.2
      Pitch: 0.3
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.65
