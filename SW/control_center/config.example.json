{
  "fixed_frame": "map",
  "base_frame": "base_link",
  "image_hz": 6,
  "image_width": 960,
  "jpeg_quality": 75,
  "cloud_hz": 5,
  "max_cloud_points": 20000,
  "cloud_decay_sec": 3.0,
  "cloud_voxel_size": 0.04,
  "max_accumulated_cloud_points": 120000,
  "cloud_point_size": 3.0,
  "use_sim_time": false,
  "task": {
    "state_file": "~/.ros/inha_control_center/task.json"
  },
  "departure": {
    "head_optical_frame": "camera_color_optical_frame"
  },
  "front_retreat": {
    "distance": 0.08
  },
  "detection": {
    "objects_topic": "/detection/head/objects",
    "odom_topic": "/odom_ekf",
    "cloud_topic": "/mid360/points_obstacles",
    "camera_info_topic": "/head/calibrated/color/camera_info",
    "surface_topic": "/mid360/points_filtered",
    "table_clearance": 0.0,
    "stage_edge_distance": 0.65,
    "grasp_max_forward": 0.5,
    "grasp_table_gap_limit": 0.03,
    "grasp_preferred_x": 0.392,
    "grasp_preferred_y": -0.078,
    "table_body_depth": 0.12
  },
  "can": {
    "auto_connect": true,
    "tracer": {
      "interface": "can_tracer",
      "usb_serial": "",
      "bitrate": 500000
    },
    "piper": {
      "interface": "can_arm",
      "usb_serial": "",
      "bitrate": 1000000
    }
  },
  "channels": {
    "map": [
      "/map"
    ],
    "scan": [
      "/scan",
      "/scan_raw"
    ],
    "odom": [
      "/odom_ekf",
      "/odom"
    ],
    "path": [
      "/plan",
      "/global_plan",
      "/navigate_to_pose/plan"
    ],
    "cloud": [
      "/mid360/points_filtered",
      "/livox/lidar",
      "/mid360/points"
    ],
    "object_cloud": [
      "/detection/wrist/object_cloud"
    ],
    "head_image": [
      "/head/camera/color/image_raw",
      "/head_camera/color/image_raw",
      "/sensors/head/color/image_raw"
    ],
    "head_debug": [
      "/detection/head/debug_image",
      "/head_yolo/debug_image"
    ],
    "wrist_image": [
      "/wrist/wrist/color/image_raw",
      "/wrist_camera/color/image_raw",
      "/sensors/wrist/color/image_raw"
    ],
    "wrist_debug": [
      "/detection/wrist/debug_image",
      "/wrist_yolo/debug_image"
    ],
    "detections": [
      "/detection/head/objects",
      "/detection/head/target",
      "/head_yolo/detections"
    ],
    "wrist_status": [
      "/detection/wrist/status"
    ],
    "battery": [
      "/battery_state",
      "/battery"
    ],
    "joints": [
      "/piper/joint_states_feedback",
      "/robot/joint_states",
      "/joint_states"
    ],
    "rosout": [
      "/rosout"
    ]
  },
  "sensors": {
    "head_camera": {
      "serial": "244622071116",
      "fps": 15
    },
    "wrist_camera": {
      "serial": "243222070076",
      "fps": 30
    },
    "g2_lidar": {
      "params_file": "~/tracer_ws/src/ydlidar_ros2_driver/params/G2.yaml"
    },
    "mid360_lidar": {
      "config_file": "~/ws_livox/src/livox_ros_driver2/config/MID360s_config.json"
    }
  },
  "slam_scan": "g2"
}
