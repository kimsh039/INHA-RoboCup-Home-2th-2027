  "image_hz": 6,
  "image_width": 960,
  "jpeg_quality": 75,
  "cloud_hz": 2,
  "max_cloud_points": 5000,
  "use_sim_time": false,
  "channels": {
    "map": [
      "/map"
    ],
    "scan": [
      "/scan",
