<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>collision_shm</transport_id>
      <type>SHM</type>
      <!-- A maximum retained scene is 250,000 * 32 bytes (8 MB).
           Fast DDS 2.6's default 512 KB segment loses these large samples. -->
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>collision_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="collision_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>collision_shm</transport_id>
        <transport_id>collision_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
